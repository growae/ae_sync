{
  "name": "@growae/aesync",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/esm/exports/index.js",
  "types": "dist/types/exports/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/exports/index.d.ts",
      "default": "./dist/esm/exports/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": ["dist", "src"],
  "bin": {
    "ae-sync": "dist/esm/bin/ae-sync.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json --outDir ./dist/esm --declaration --declarationMap --declarationDir ./dist/types",
    "clean": "rm -rf dist",
    "check:types": "tsc --noEmit",
    "dev": "tsc --project tsconfig.build.json --outDir ./dist/esm --declaration --declarationMap --declarationDir ./dist/types --watch"
  },
  "dependencies": {
    "blakejs": "^1.2.1",
    "commander": "^13.0.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.44.0",
    "eventemitter3": "^5.0.0",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.10.0",
    "hono": "^4.7.0",
    "@hono/node-server": "^1.13.0",
    "pg": "^8.13.0",
    "@electric-sql/pglite": "^0.2.0",
    "vite": "^6.0.0",
    "vite-node": "^3.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
